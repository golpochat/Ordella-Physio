# Repository root (auto-detected by scripts if empty)
REPO_ROOT=

# Node / package manager
NODE_VERSION=20
PNPM_VERSION=9.15.4

# Playwright E2E
PLAYWRIGHT_BASE_URL=http://localhost:3010
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SKIP_WEBSERVER=true
API_GATEWAY_URL=http://localhost:3049
# Must match root `.env` / billing-service (docker-compose reads STRIPE_WEBHOOK_SECRET from repo root)
STRIPE_WEBHOOK_SECRET=whsec_local_dev_stripe_webhook_secret

# CI placeholders
CI_DOCKER_REGISTRY=ghcr.io/ordella
CI_DOCKER_IMAGE_PREFIX=ordella-physio
CI_TURBO_TOKEN=
CI_TURBO_TEAM=

# Tooling paths (relative to repo root)
TOOLING_LAYER_PATH=infrastructure/developer-tooling-layer
