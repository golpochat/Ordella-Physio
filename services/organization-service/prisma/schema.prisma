generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum BillingModel {
  TENANT_LEVEL
  ORGANIZATION_LEVEL
}

enum OrganizationSubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

model Organization {
  id                  String                          @id @default(cuid())
  name                String
  code                String                          @unique
  description         String?
  primaryContactName  String
  primaryContactEmail String
  primaryContactPhone String?
  billingModel        BillingModel                    @default(TENANT_LEVEL)
  stripeCustomerId    String?                         @unique
  stripeSubscriptionId String?                        @unique
  subscriptionStatus  OrganizationSubscriptionStatus?
  status              OrganizationStatus              @default(ACTIVE)
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt
  tenantLinks         OrganizationTenant[]
  configs             OrganizationConfig[]
  ssoConfig           OrganizationSsoConfig?

  @@map("organizations")
}

enum SsoProtocol {
  SAML
  OIDC
}

model OrganizationSsoConfig {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ssoEnabled           Boolean      @default(false)
  ssoProtocol          SsoProtocol?
  ssoMetadataUrl       String?
  ssoEntityId          String?
  ssoAcsUrl            String?
  ssoCertificate       String?
  ssoClientId          String?
  ssoClientSecret      String?
  ssoIssuer            String?
  ssoRedirectUri       String?
  ssoLogoutUrl         String?
  ssoJwksUrl           String?
  roleMappings         Json?
  previousCertificates Json?
  metadataCache        Json?
  metadataFetchedAt    DateTime?
  metadataValidatedAt  DateTime?
  allowSelfSignedCerts Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@map("organization_sso_configs")
}

model OrganizationConfig {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  namespace       String
  data            Json
  updatedByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, namespace])
  @@index([organizationId])
  @@map("organization_configs")
}

model OrganizationTenant {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenantId       String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, tenantId])
  @@unique([tenantId])
  @@map("organization_tenants")
}
