{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "watchAssets": false,
    "assets": [
      {
        "include": "generated/**/*",
        "exclude": "**/*.node",
        "outDir": "dist/services/terminal-service/src"
      }
    ]
  }
}
