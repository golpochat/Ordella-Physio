NODE_ENV=development
PORT=3071
DATABASE_URL=postgresql://physio:physio@localhost:5432/ordella_file_storage?schema=public
JWT_ACCESS_SECRET=change-me-to-a-secure-secret-at-least-32-chars

# Production: STORAGE_DEFAULT_PROVIDER=S3 with bucket credentials below.
STORAGE_DEFAULT_PROVIDER=LOCAL
STORAGE_FAILOVER_PROVIDERS=S3,LOCAL
STORAGE_LOCAL_BASE_PATH=./uploads/files
CDN_ENABLED=false
CDN_BASE_URL=https://cdn.sheba360.com
CDN_SIGN_URLS=false
FILE_STORAGE_PUBLIC_BASE_URL=http://localhost:3049/files
FILE_STORAGE_SIGNED_URL_TTL_SECONDS=60
FILE_STORAGE_MAX_BYTES=52428800
AUDIT_SERVICE_URL=http://localhost:3070

# Production: CLAMAV_ENABLED=true with CLAMAV_HOST reachable (fail-fast on startup if not).
# Local dev without ClamAV container: set CLAMAV_ENABLED=false and CLAMAV_REQUIRED=false
CLAMAV_ENABLED=false
CLAMAV_REQUIRED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
FILE_STORAGE_MAX_BYTES=52428800

# S3 (file-storage-service is the only component that touches the bucket)
S3_BUCKET=ordella-uploads-prod
S3_REGION=eu-west-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Legacy aliases (still supported)
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

STORAGE_GCS_BUCKET=
STORAGE_GCS_PROJECT_ID=

LOG_LEVEL=info
CORS_ORIGIN=*
SUBSCRIPTION_BILLING_SERVICE_URL=http://localhost:3074
