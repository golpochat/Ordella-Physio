# Local Docker dev — copy to `.env` at repo root (docker compose reads this file).
# See docs/ops-reference.md § "Stripe billing (local dev)" for full setup.

POSTGRES_USER=physio
POSTGRES_PASSWORD=physio
API_GATEWAY_PORT=3049

# JWT (dev only — replace in production)
JWT_ACCESS_SECRET=change-me-local-jwt-secret-min-32-chars

# Stripe test mode (required for real Checkout + Customer Portal flows)
# Get keys from https://dashboard.stripe.com/test/apikeys
# Run `pnpm stripe:wire-local` after setting STRIPE_SECRET_KEY to create price IDs.
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_local_dev_stripe_webhook_secret
STRIPE_PRICE_STARTER=price_local_starter
STRIPE_PRICE_PRO=price_local_pro
STRIPE_PRICE_ENTERPRISE=price_local_enterprise
STRIPE_PRICE_AI_NOTES=price_local_ai_notes

# Optional: monolith fake-card checkout when USE_CLINIC_BACKEND=true (dev only)
# NEXT_PUBLIC_ALLOW_DB_CHECKOUT=true
