# =============================================================================
# Ordella Clinic Backend — environment variables
# Copy to `.env` and adjust for your environment.
# =============================================================================

# --- Core ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/clinic_backend?schema=public

# --- JWT (min 32 characters; use cryptographically random values in production) ---
JWT_SECRET=change-me-in-production-use-long-random-string-32
JWT_SECRET_PREVIOUS=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_SECRET_PREVIOUS=
JWT_REFRESH_EXPIRES_IN=7d

# --- Multi-tenant / CORS ---
TENANT_HEADER=x-tenant-id
FRONTEND_URL=http://localhost:3010
CORS_ORIGINS=http://localhost:3010,http://localhost:3011

# --- CSRF (required in production) ---
CSRF_SECRET=dev-csrf-secret-minimum-32-characters-long

# --- Onboarding ---
TRIAL_DURATION_DAYS=14

# --- Transport / proxy ---
TRUST_PROXY=false
FORCE_HTTPS=false

# --- Rate limiting (global + auth endpoints) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# --- Brute-force / account lockout ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_BASE_MS=300000
LOGIN_LOCKOUT_MAX_MS=3600000

# --- Redis (optional — distributed rate limits + brute-force counters) ---
# When unset, falls back to in-memory counters per process.
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=clinic-backend:

# --- File storage (all uploads scanned via file-storage-service + ClamAV) ---
FILE_STORAGE_SERVICE_URL=http://localhost:3071
FILE_STORAGE_MAX_BYTES=52428800

# --- ClamAV virus scanning (optional — enable when upload routes are live) ---
# When CLAMAV_HOST is unset, uploads pass validation only (no scan).
# Set CLAMAV_REQUIRED=true in production to reject uploads if ClamAV is down.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
CLAMAV_REQUIRED=true

# --- Observability ---
SENTRY_DSN=

# --- Email (optional — uses JSON transport in dev when SMTP_HOST is unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ordella.local

# --- Encrypted database backups ---
# Generate BACKUP_ENCRYPTION_KEY with: openssl rand -base64 32
BACKUP_ENCRYPTION_KEY=dev-backup-encryption-key-min-32-chars
BACKUP_OUTPUT_DIR=backups
BACKUP_RETENTION_DAYS=30
# Uses native pg_dump when available, otherwise docker exec into this container:
BACKUP_DOCKER_CONTAINER=ordella-physio-clinic-backend-db
# Cron examples:
#   Linux:   0 2 * * * /path/to/backend/scripts/backup-run.sh
#   Windows: schtasks /Create /SC DAILY /TN "OrdellaClinicBackup" /TR "powershell -File C:\path\to\backend\scripts\backup-run.ps1" /ST 02:00
# Docker:    docker compose -f docker-compose.dev.yml --profile backup up -d clinic-backend-backup-cron
BACKUP_CRON_SCHEDULE=0 2 * * *
