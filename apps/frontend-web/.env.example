# =============================================================================
# Ordella Frontend Web — environment variables
# Copy to `.env` and adjust for your environment.
# =============================================================================

# --- Core ---
NODE_ENV=development
PORT=3010
NEXT_PUBLIC_APP_URL=http://localhost:3010

# --- Marketing analytics (optional — scripts load only when set) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_HOTJAR_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_SENTRY_DSN=

# --- API routing ---
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:3049
API_GATEWAY_INTERNAL_URL=http://localhost:3049

# --- Tenant defaults ---
NEXT_PUBLIC_DEFAULT_TENANT_ID=demo-tenant
TENANT_DEFAULT=demo-tenant
DEFAULT_TENANT_ID=demo-tenant

# --- Monolithic clinic backend (set USE_CLINIC_BACKEND=true to route portal APIs here) ---
USE_CLINIC_BACKEND=true
NEXT_PUBLIC_USE_CLINIC_BACKEND=true
# Dev only: disable Next.js /api rate limit while iterating locally
# DISABLE_API_RATE_LIMIT=true
CLINIC_BACKEND_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_CLINIC_BACKEND_URL=http://localhost:4000

# --- Billing checkout ---
# Set true only for monolith-only dev without Stripe (fake card → DB). Default: Stripe Checkout via gateway.
NEXT_PUBLIC_ALLOW_DB_CHECKOUT=false

# --- Marketing contact form (optional webhook — Slack, Zapier, etc.) ---
CONTACT_WEBHOOK_URL=

# --- Auth / session (min 32 characters in production) ---
NEXTAUTH_URL=http://localhost:3010
NEXTAUTH_SECRET=change-me-use-at-least-32-characters-long-secret
SESSION_COOKIE_SECRET=change-me-use-at-least-32-characters-long-secret
JWT_ACCESS_SECRET=change-me-use-at-least-32-characters-long-secret

# --- API rate limiting (middleware — optional Upstash for multi-instance) ---
API_RATE_LIMIT=120
DISABLE_API_RATE_LIMIT=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_KEY_PREFIX=ordella-frontend:

# --- Content Security Policy ---
# Nonce-based CSP is applied in middleware. Set DISABLE_NONCE_CSP=true to debug locally.
DISABLE_NONCE_CSP=false
CSP_REPORT_URI=

# --- Staging / production ---
# See deploy/staging/.env.staging and deploy/production/.env.production when deploying.
